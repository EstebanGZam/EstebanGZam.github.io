---
interface Props {
  id: string;
  index: number;
  title: string;
}

const { id, index, title } = Astro.props;
---

<div class="section-head">
  <span class="section-index" aria-hidden="true">{String(index).padStart(2, "0")}</span>
  <h2 id={`${id}-title`} class="section-title">{title}</h2>
</div>
