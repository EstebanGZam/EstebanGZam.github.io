---
import EntryCard from "./EntryCard.astro";
import SectionHead from "./SectionHead.astro";
import { CONTENT, byFocus, type Focus, type Lang } from "../content/site";

interface Props {
  lang: Lang;
  focus: Focus;
  index: number;
}

const { lang, focus, index } = Astro.props;
const c = CONTENT[lang];
const entries = byFocus(c.projects, focus);
const small = byFocus(c.smallProjects, focus);

// The AI view leads with the AI projects; the other views lead with the platform case study.
const smallFirst = focus === "ai";
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container stack">
    <SectionHead id="projects" index={index} title={c.ui.sections.projects} />
    {!smallFirst && entries.map((entry) => <EntryCard entry={entry} lang={lang} focus={focus} />)}
    <div class="small-grid">
      {
        small.map((p) => (
          <article class="compact card">
            <div class="compact-head">
              <h3>
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener noreferrer">
                    {p.name}
                    <span class="visually-hidden"> {c.ui.opensInNewTab}</span>
                  </a>
                ) : (
                  p.name
                )}
              </h3>
              <p class="mono muted">{p.period}</p>
            </div>
            <p class="muted">{p.text}</p>
          </article>
        ))
      }
    </div>
    {smallFirst && entries.map((entry) => <EntryCard entry={entry} lang={lang} focus={focus} />)}
  </div>
</section>

<style>
  .small-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .small-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .compact {
    align-content: start;
  }
</style>
