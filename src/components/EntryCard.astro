---
import FlowDiagram from "./FlowDiagram.astro";
import { CONTENT, byFocus, type Entry, type Focus, type Lang } from "../content/site";

interface Props {
  entry: Entry;
  lang: Lang;
  focus: Focus;
  headingLevel?: "h3" | "h4";
}

const { entry, lang, focus, headingLevel = "h3" } = Astro.props;
const t = CONTENT[lang].ui;
const Heading = headingLevel;
const bullets = byFocus(entry.bullets, focus);
---

<article class="entry card">
  <header class="entry-head">
    <div>
      <Heading class="entry-name">{entry.name}</Heading>
      <p class="entry-role">{entry.role}{entry.location && <span class="muted"> · {entry.location}</span>}</p>
    </div>
    <p class="entry-period mono">{entry.period}</p>
  </header>

  <p class="entry-summary muted">{entry.summary}</p>

  <ul class="entry-bullets">
    {bullets.map((b) => <li>{b.text}</li>)}
  </ul>

  {entry.flow && <FlowDiagram flow={entry.flow} />}

  {
    entry.links.length > 0 && (
      <ul class="entry-links" role="list">
        {entry.links.map((l) => (
          <li>
            <a class="button" href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
              <span class="visually-hidden">{t.opensInNewTab}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .entry {
    padding: 1.25rem;
  }

  @media (min-width: 720px) {
    .entry {
      padding: 1.75rem;
    }
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .entry-name {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .entry-role {
    margin-top: 0.125rem;
    font-weight: 550;
  }

  .entry-period {
    font-size: 0.875rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .entry-summary {
    margin-top: 0.75rem;
    max-width: 50rem;
  }

  .entry-bullets {
    display: grid;
    gap: 0.625rem;
    margin-top: 1rem;
    padding-left: 1.125rem;
    max-width: 52rem;
  }

  .entry-bullets li::marker {
    color: var(--accent);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.25rem;
    list-style: none;
  }
</style>
