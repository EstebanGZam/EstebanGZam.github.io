---
import { CONTENT, byFocus, type Focus, type Lang } from "../content/site";

interface Props {
  lang: Lang;
  focus: Focus;
}

const { lang, focus } = Astro.props;
const c = CONTENT[lang].credentials;
const certs = byFocus(c.certs, focus);
---

<div class="credentials">
  <section class="block card" aria-labelledby="edu-title">
    <h3 id="edu-title">{c.educationTitle}</h3>
    <p class="strong">{c.education.school}</p>
    <p>{c.education.degree}</p>
    <p class="muted small">{c.education.detail}</p>
  </section>

  <section class="block card" aria-labelledby="certs-title">
    <h3 id="certs-title">{c.certsTitle}</h3>
    <ul class="list" role="list">
      {
        certs.map((cert) => (
          <li>
            <p class="strong">{cert.name}</p>
            <p class="muted small">{cert.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block card" aria-labelledby="other-title">
    <h3 id="other-title">{c.otherTitle}</h3>
    <ul class="list" role="list">
      {
        c.other.map((o) => (
          <li>
            <p class="strong">{o.label}</p>
            <p class="muted small">{o.text}</p>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .credentials {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 860px) {
    .credentials {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .block {
    padding: 1.25rem;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .strong {
    font-weight: 600;
  }

  .small {
    font-size: 0.9375rem;
  }

  .list {
    display: grid;
    gap: 0.875rem;
    list-style: none;
  }
</style>
